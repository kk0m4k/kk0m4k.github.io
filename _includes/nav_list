{% assign navigation = site.data.navigation[include.nav] %}

<nav class="nav__list">
  {% if page.sidebar.title %}<h3 class="nav__title" style="padding-left: 0;">{{ page.sidebar.title }}</h3>{% endif %}
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
    {% for nav in navigation %}
      <li>
        {% if nav.url %}
          <a href="{{ nav.url | relative_url }}"><span class="nav__sub-title">{{ nav.title }}</span></a>
        {% else %}
          <span class="nav__sub-title">{{ nav.title }}</span>
        {% endif %}

        {% if nav.children != null %}
        <ul class="nav-tree">
          {% for child in nav.children %}
            {% assign child_index = forloop.index %}
            <li class="nav-tree-item">
              <div class="nav-item-wrapper">
                {% if child.children %}
                  <span class="toggle-icon" data-toggle="nav-{{ nav.title | slugify }}-{{ child_index }}">+</span>
                {% else %}
                  <span class="dash-icon">-</span>
                {% endif %}
                <a href="{{ child.url | relative_url }}"{% if child.url == page.url %} class="active"{% endif %}>{{ child.title }}</a>
              </div>
              
              {% if child.children != null %}
                <ul class="nav-subtree" id="nav-{{ nav.title | slugify }}-{{ child_index }}" style="display: none;">
                  {% for subchild in child.children %}
                    <li class="nav-subtree-item">
                      <span class="subtree-icon">└</span>
                      <a href="{{ subchild.url | relative_url }}"{% if subchild.url == page.url %} class="active"{% endif %}>{{ subchild.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>